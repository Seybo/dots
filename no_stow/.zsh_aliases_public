### AI agents ###
_agent_attention_notify_for_current_tmux_pane() {
  local watcher="$STOW_DIR/no_stow/bin/tmux/agent-attention-notify"
  local watcher_pattern
  local wait_count=0

  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -x "$watcher" ]; then
    watcher_pattern="agent-attention-notify --pane $TMUX_PANE"
    pkill -f "$watcher_pattern" >/dev/null 2>&1 || true

    while pgrep -f "$watcher_pattern" >/dev/null 2>&1 && [ "$wait_count" -lt 40 ]; do
      sleep 0.05
      wait_count=$((wait_count + 1))
    done

    if ! pgrep -f "$watcher_pattern" >/dev/null 2>&1; then
      "$watcher" --pane "$TMUX_PANE" >/dev/null 2>&1 &!
    fi
  fi
}

_run_with_agent_attention() {
  local agent_command="$1"
  local watcher="$STOW_DIR/no_stow/bin/tmux/agent-attention-notify"
  local exit_status
  shift

  _agent_attention_notify_for_current_tmux_pane
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -x "$watcher" ]; then
    "$watcher" --agent-start "$TMUX_PANE" >/dev/null 2>&1 || true
  fi

  # Run the agent in a child shell so interrupt/term signals return here for cleanup.
  (
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    command "$agent_command" "$@"
  )
  exit_status=$?

  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -x "$watcher" ]; then
    "$watcher" --agent-stop "$TMUX_PANE" >/dev/null 2>&1 || true
  fi

  return "$exit_status"
}

claude() {
  _run_with_agent_attention claude "$@"
}

codex() {
  _run_with_agent_attention codex "$@"
}

hermes() {
  _run_with_agent_attention hermes "$@"
}

gtm() {
  _run_with_agent_attention gtm "$@"
}

_pi_require_shared_agents() {
  local profile_dir="$1"
  local agents_path="$profile_dir/AGENTS.md"
  local shared_path="$HOME/.ai/rules/pi-global.md"

  if [ ! -L "$agents_path" ] || [ "$(realpath "$agents_path" 2>/dev/null)" != "$(realpath "$shared_path" 2>/dev/null)" ]; then
    print -u2 -- "Refusing to start Pi: $agents_path is not linked to $shared_path."
    return 1
  fi
}

pi() {
  print -u2 -- "Direct pi is disabled. Current PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR:-unset}. Use pi-w for $HOME/.pi/work or pi-p for $HOME/.pi/personal."
  return 1
}

pi-p() {
  _pi_require_shared_agents "$HOME/.pi/personal" || return
  local -x PATH="$HOME/.asdf/installs/nodejs/24.0.1/bin:$PATH"
  PI_CODING_AGENT_DIR="$HOME/.pi/personal" \
  NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=\"$STOW_DIR/no_stow/pi-regexp-safety.cjs\"" \
  _run_with_agent_attention pi "$@"
}
pi-w() {
  _pi_require_shared_agents "$HOME/.pi/work" || return
  local -x PATH="$HOME/.asdf/installs/nodejs/24.0.1/bin:$PATH"
  PI_CODING_AGENT_DIR="$HOME/.pi/work" \
  NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=\"$STOW_DIR/no_stow/pi-regexp-safety.cjs\"" \
  _run_with_agent_attention pi "$@"
}
