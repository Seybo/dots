xnv() {
  open -a XnViewMP --args "${1:-$PWD}"
}
pwdc() {
  local current_path
  current_path="$(builtin pwd "$@")" || return
  print -r -- "$current_path"
  print -rn -- "$current_path" | pbcopy
}
theme() {
  ruby ~/.dots/themes/theme_switcher.rb "$@"
  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    tmux source-file "$STOW_DIR/.tmux.conf"
  fi
  if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
    osascript -e 'tell application "/Applications/Ghostty.app" to perform action "reload_config" on focused terminal of selected tab of front window' >/dev/null
  fi
}


