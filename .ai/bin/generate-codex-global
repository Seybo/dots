#!/usr/bin/env bash
# Regenerates .ai/rules/codex-global.md (Codex's globally loaded AGENTS.md) from
# its source rule files. Edit the sources, then rerun this script.
set -euo pipefail

cd "$(dirname "$0")/../rules"

SOURCES=(
  response-style.md
  development-principles.md
)

{
  printf '<!-- Generated by .ai/bin/generate-codex-global. Do not edit by hand; edit the source files in .ai/rules/ and rerun the generator. -->\n'
  for f in "${SOURCES[@]}"; do
    printf '<!-- Source: .ai/rules/%s -->\n\n' "$f"
    cat "$f"
    printf '\n'
  done
} > codex-global.md

echo "codex-global.md regenerated from: ${SOURCES[*]}"
