#!/usr/bin/env bash
# Regenerates .ai/rules/pi-global.md (Pi's globally loaded AGENTS.md) from its
# source rule files. Edit the sources, then rerun this script.
set -euo pipefail

cd "$(dirname "$0")/../rules"

# Order matters: shared rules first, then Pi-only rules, then abbreviations.
SOURCES=(
  response-style.md
  development-principles.md
  ruby-general.md
  agent-ops.md
  pi-only.md
  placeholder-stubs.md
  abbreviations.md
)

{
  printf '<!-- Generated by .ai/bin/generate-pi-global. Do not edit by hand; edit the source files in .ai/rules/ and rerun the generator. -->\n'
  for f in "${SOURCES[@]}"; do
    printf '<!-- Source: .ai/rules/%s -->\n\n' "$f"
    cat "$f"
    printf '\n'
  done
} > pi-global.md

echo "pi-global.md regenerated from: ${SOURCES[*]}"
