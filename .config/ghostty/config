macos-icon = blueprint
config-file = "~/.dots/themes/active/ghostty"

font-family = "SauceCodePro Nerd Font Mono"
font-family-bold = "Hack Nerd Font"
font-family-italic = "Iosevka Nerd Font Mono"
font-family-bold-italic = "Hack Nerd Font"

font-size = 14
# cmd+shift+0 => reset font size to configured default
keybind = cmd+shift+0=reset_font_size
# cmd+ctrl+shift+r => reload Ghostty configuration
keybind = cmd+ctrl+shift+r=reload_config
font-thicken = false
adjust-cell-height = 0
adjust-box-thickness = 0

window-decoration = auto
window-padding-x = 10
window-padding-y = 6
window-width = 226
window-height = 64
window-position-x = 128
window-position-y = 73
fullscreen = true
macos-titlebar-style = hidden

minimum-contrast = 1.1

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

copy-on-select = clipboard
clipboard-paste-protection = true
macos-option-as-alt = true
quit-after-last-window-closed = true

# Zellij/tmux tabs
# cmd+t => enter tab/window mode
keybind = cmd+t=text:
# cmd+u => previous tab/window
keybind = cmd+u=text:
# cmd+m => next tab/window
keybind = cmd+m=text:

# Tmux session navigation
# cmd+s => enter session navigation mode
keybind = cmd+s=text:
# cmd+shift+comma/period/slash => attention, base, and session picker
keybind = cmd+shift+comma=text:⟬
keybind = cmd+shift+period=text:⟭
keybind = cmd+shift+slash=text:⟮
# cmd+o => enter session operations mode
keybind = cmd+o=text:⚙

# Zellij panes
# cmd+p => enter pane mode
keybind = cmd+p=text:

# Zellij search
# cmd+/ => enter search mode
keybind = cmd+slash=text:

# Zellij scroll
# cmd+; => enter scroll mode
keybind = cmd+semicolon=text:

# Zellij pane navigation
# cmd+h/j/k/l => move focus left/down/up/right
keybind = cmd+h=text:
keybind = cmd+j=text:
keybind = cmd+k=text:
keybind = cmd+l=text:
# cmd+shift+h/j/k/l => resize pane left/down/up/right
keybind = cmd+shift+h=text:
keybind = cmd+shift+j=text:
keybind = cmd+shift+k=text:
keybind = cmd+shift+l=text:
# cmd+shift+f => zoom/unzoom the active tmux pane
keybind = cmd+shift+f=text:
# cmd+shift+u/m => previous/next tmux session
keybind = cmd+shift+u=text:⟨
keybind = cmd+shift+m=text:⟩

